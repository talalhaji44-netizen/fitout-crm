# Clerk — get these from https://dashboard.clerk.com
# Requires Organizations to be enabled in the Clerk dashboard (Configure → Organizations)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk redirect URLs (keep these defaults for local development)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/org-select

# Neon Postgres — pooled connection (used at runtime by Prisma)
# Format: postgresql://user:password@pooler.neon.tech/dbname?sslmode=require&pgbouncer=true
DATABASE_URL=

# Neon Postgres — direct connection (used by prisma migrate only, bypasses PgBouncer)
# Format: postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DIRECT_URL=

# Vercel Blob — for future private file storage; no upload code exists yet
BLOB_READ_WRITE_TOKEN=
